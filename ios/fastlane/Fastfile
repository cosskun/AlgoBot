default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_PRIVATE_KEY"],
      is_key_content_base64: false
    )

    kc_name = "fastlane_keychain"
    kc_pass = "fastlane_password"

    create_keychain(
      name: kc_name,
      password: kc_pass,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    kc_file = File.expand_path("~/Library/Keychains/#{kc_name}-db")

    get_certificates(
      keychain_path: kc_file,
      keychain_password: kc_pass,
      development: false
    )

    get_provisioning_profile(
      app_identifier: "com.algokids.algobotFlutter",
      development: false
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      clean: false,
      output_directory: "./build_fastlane",
      output_name: "AlgoBot.ipa"
    )

    upload_to_testflight(
      ipa: "./build_fastlane/AlgoBot.ipa",
      skip_waiting_for_build_processing: true
    )
  end
end